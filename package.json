{
  "name": "mockdrop",
  "version": "1.1.2",
  "description": "Generate high-quality dummy data instantly. Zero dependencies. Works everywhere.",
  "main": "dist/mockdrop.cjs.js",
  "module": "dist/mockdrop.mjs",
  "browser": "dist/mockdrop.umd.js",
  "unpkg": "dist/mockdrop.umd.js",
  "jsdelivr": "dist/mockdrop.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/mockdrop.umd.js",
      "import": "./dist/mockdrop.mjs",
      "require": "./dist/mockdrop.cjs.js",
      "default": "./dist/mockdrop.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && node scripts/copy-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "rollup -c rollup.config.mjs -w",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mock",
    "dummy",
    "fake",
    "data",
    "generator",
    "testing",
    "seed",
    "random",
    "test-data",
    "prototyping"
  ],
  "author": "Jayesh Puri Goswami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayeshGoswami26/mockdrop"
  },
  "homepage": "https://github.com/JayeshGoswami26/mockdrop#readme",
  "bugs": {
    "url": "https://github.com/JayeshGoswami26/mockdrop/issues"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.28.0",
    "typescript": "^7.0.2",
    "vitest": "^3.1.0"
  }
}
